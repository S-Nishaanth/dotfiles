configuration {
    modi: "drun";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    display-drun: " ";
    drun-display-format: "{name}";
}

* {
    bg-col: #1f1f28;
    bg-sel: #2a2a37;
    border-col: #54546d;
    fg-col: #dcd7ba;
    fg-sel: #7e9cd8;
    background-color: @bg-col;
    text-color: @fg-col;
}

window {
    width: 600px;
    border: 2px;
    border-color: @border-col;
    border-radius: 16px;
    background-color: @bg-col;
    padding: 15px;
}

mainbox {
    background-color: @bg-col;
    spacing: 10px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    padding: 5px;
}

prompt {
    background-color: @bg-col;
    text-color: @fg-sel;
    padding: 6px 10px 6px 6px;
}

entry {
    background-color: @bg-col;
    text-color: @fg-col;
    padding: 6px;
}

listview {
    background-color: @bg-col;
    columns: 1;
    lines: 7;
    padding: 10px 0 0 0;
    border: 0px;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg-col;
    padding: 8px;
}

element-icon {
    size: 24px;
    padding: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg-col;
}

element selected.normal {
    background-color: @bg-sel;
    text-color: @fg-sel;
    border: 1px;
    border-radius: 6px;
    border-color: @border-col;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @fg-sel;
}

element selected.active {
    background-color: @bg-sel;
    text-color: @fg-sel;
    border: 1px;
    border-radius: 6px;
    border-color: @border-col;
}
